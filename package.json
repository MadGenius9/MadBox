{
  "name": "madbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx scripts/run-tests.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:soak": "node scripts/browser-soak.mjs",
    "format": "prettier --write src tests scripts docs README.md index.html package.json tsconfig.json",
    "test:browser:touch": "node scripts/browser-touch.mjs"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "pixi.js": "^8.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
